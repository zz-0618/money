{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
"vars": {
    "VITE_GOOGLE_MAPS_API_KEY": "AIzaSyBUsFxyszEtFeLLVXzg9mTLHPKKDxxKX9I"
  }
}
