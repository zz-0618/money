{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist"
    },
  "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
    },
  },
"main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
